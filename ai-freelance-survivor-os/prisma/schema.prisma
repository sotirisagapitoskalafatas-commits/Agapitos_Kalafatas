generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
model AiAgent { id String @id @default(cuid()) name String state String strategy String mode String objective String createdAt DateTime @default(now()) updatedAt DateTime @updatedAt opportunities AiOpportunity[] approvals AiApproval[] memories AiMemory[] transactions AiTransaction[] events AiEvent[] }
model AiOpportunity { id String @id @default(cuid()) agentId String? source String title String description String url String? budget Float currency String estimatedHours Float skills Json clientName String clientRating Float competition Float deadlineHours Float platformFeePct Float difficulty Float status String @default("DISCOVERED") createdAt DateTime @default(now()) updatedAt DateTime @updatedAt agent AiAgent? @relation(fields:[agentId],references:[id]) }
model AiApproval { id String @id @default(cuid()) agentId String type String targetId String description String amount Float? risk String status String @default("PENDING") createdAt DateTime @default(now()) updatedAt DateTime @updatedAt agent AiAgent @relation(fields:[agentId],references:[id]) }
model AiMemory { id String @id @default(cuid()) agentId String kind String text String importance Float tags Json source String createdAt DateTime @default(now()) agent AiAgent @relation(fields:[agentId],references:[id]) }
model AiTransaction { id String @id @default(cuid()) agentId String type String amount Float description String balanceAfter Float createdAt DateTime @default(now()) agent AiAgent @relation(fields:[agentId],references:[id]) }
model AiEvent { id String @id @default(cuid()) agentId String name String data Json createdAt DateTime @default(now()) agent AiAgent @relation(fields:[agentId],references:[id]) }
