# Environment Variables
# Copy this file to .env (used by docker-compose, the Python agent, and the
# local cleanup script) and to web/.env.local for running the Next.js app
# directly with `npm run dev`.
#
# DO NOT commit the real .env / .env.local files — they hold secrets.

# ── AI / LLM ────────────────────────────────────────────────────────────────
# Gemini AI API Key (required for the public chat agent and orchestrator)
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API key (optional — used for RAG embeddings over the knowledge base)
# OPENAI_API_KEY=your_openai_api_key_here

# ── Supabase (required) ──────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://jbmccmokfvyvijmumuzn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Service-role key — server-side only, NEVER exposed to the browser
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ── Admin auth (required in production; fail-closed) ────────────────────────
ADMIN_USER=agapitos
ADMIN_PASS=your_strong_admin_password_here
# Optional: HMAC signing secret for session tokens (falls back to ADMIN_PASS)
# AUTH_SECRET=your_auth_secret_here

# ── Notifications (optional) ────────────────────────────────────────────────
# Incoming leads webhook: sent by this platform to these channels
SLACK_WEBHOOK_URL=
# Shared secret the Supabase lead-insert webhook must present (x-webhook-secret)
SUPABASE_WEBHOOK_SECRET=your_webhook_secret_here
# Recipient for Resend email alerts + contact-form notifications
NOTIFY_EMAIL_TO=kalafatasagapitos@gmail.com
RESEND_API_KEY=your_resend_api_key_here

# ── Plugin connector credentials (optional, replace stub data) ──────────────
# STRIPE_SECRET_KEY=your_stripe_secret_key_here

# ── ElevenLabs (optional, for premium voice) ────────────────────────────────
# ELEVENLABS_API_KEY=your_elevenlabs_key_here
